# Dummy example values: replace everything before deploying.
PORT=5000
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/zenith

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# Public media CDN (CloudFront on the media subdomain). Files are served from
# here, never through the API. No trailing slash.
CDN_BASE_URL=https://media.thezenithlearning.com

# All uploads are stored in S3. Credentials may be omitted when using an IAM role.
AWS_REGION=ap-south-1
# Private S3 bucket; only CloudFront (OAC) and the API's IAM identity can reach it.
S3_BUCKET=your-zenith-media-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Legacy in-memory upload helper limit. The file manager separately allows 1 GB.
MAX_VIDEO_UPLOAD_MB=50

# Comma-separated list of allowed frontend origins.
FRONTEND_URL=http://localhost:3000
# Public website origin for CMS page canonical URLs / sitemap (defaults to FRONTEND_URL).
SITE_URL=http://localhost:3000
# Store CMS page HTML unsanitised (full pages with own <style>/<script>). Default: false.
PAGES_ALLOW_RAW_HTML=false

ADMIN_EMAIL=admin@thezenithlearning.com
ADMIN_PASSWORD=replace-with-a-strong-password
